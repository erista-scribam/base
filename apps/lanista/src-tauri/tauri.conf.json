{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scribo Lanista",
  "version": "0.4.0",
  "identifier": "com.scribo.lanista",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Scribo Lanista",
        "width": 720,
        "height": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../../prosa/src-tauri/icons/32x32.png",
      "../../prosa/src-tauri/icons/128x128.png",
      "../../prosa/src-tauri/icons/128x128@2x.png",
      "../../prosa/src-tauri/icons/icon.icns",
      "../../prosa/src-tauri/icons/icon.ico"
    ]
  }
}
