{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scribam Prosa",
  "version": "0.5.1",
  "identifier": "com.scribam.prosa",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm icons && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Scribam Prosa",
        "width": 1280,
        "height": 840,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "fullscreen": false,
        "maximized": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "bundleName": "Scribam Prosa"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
