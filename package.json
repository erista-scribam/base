{
  "name": "scribam",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "version": "0.6.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @scribam/prosa dev",
    "tauri": "pnpm --filter @scribam/prosa tauri",
    "tauri:dev": "pnpm --filter @scribam/prosa tauri dev",
    "tauri:build": "pnpm --filter @scribam/prosa tauri build",
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm --filter @scribam/prosa build",
    "verify:rust": "cargo fmt --all --check && cargo clippy --locked --workspace --all-targets -- -D warnings && cargo check --locked --workspace",
    "verify:git-spike": "cargo test -p prosa --features git-spike git_spike",
    "verify:all": "pnpm verify && pnpm verify:rust",
    "hooks:install": "sh scripts/setup-git-hooks.sh",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-tauri-version.mjs",
    "release:publish": "node scripts/release-publish.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
