{
  "name": "scribo",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @scribo/prosa dev",
    "tauri": "pnpm --filter @scribo/prosa tauri",
    "tauri:dev": "pnpm --filter @scribo/prosa tauri dev",
    "tauri:build": "pnpm --filter @scribo/prosa tauri build",
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm --filter @scribo/prosa build",
    "verify:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && cargo check --workspace",
    "verify:all": "pnpm verify && pnpm verify:rust",
    "hooks:install": "sh scripts/setup-git-hooks.sh",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-tauri-version.mjs",
    "release:publish": "node scripts/release-publish.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.8"
  }
}
